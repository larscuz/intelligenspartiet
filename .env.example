# Admin auth
ADMIN_EMAIL=lars@larscuzner.com
ADMIN_SETUP_KEY=replace-with-long-random-string
ADMIN_PEPPER=replace-with-long-random-string
ADMIN_SESSION_SECRET=replace-with-long-random-string

# GitHub repo write access (for /api/repo-file and auth config persistence)
GITHUB_TOKEN=replace-with-github-token
GITHUB_OWNER=larscuz
GITHUB_REPO=intelligenspartiet
GITHUB_BRANCH=main

# Gemini translation (for /api/translate-glyphs)
GEMINI_API_KEY=replace-with-google-ai-studio-key
# Optional override (defaults to gemini-2.0-flash)
GEMINI_TRANSLATE_MODEL=gemini-2.0-flash

# Optional R2 upload support
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=
